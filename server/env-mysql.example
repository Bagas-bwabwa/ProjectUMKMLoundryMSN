# Database - MySQL Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=laundry_db
MYSQL_PORT=3306

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Configuration (optional for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Notes:
# 1. Replace 'your_mysql_password_here' with your actual MySQL root password
# 2. For MySQL 8.0, you might need to use mysql_native_password plugin:
#    ALTER USER 'root'@'localhost' IDENTIFIED WITH mysql_native_password BY 'your_password';
# 3. Make sure MySQL service is running before starting the server